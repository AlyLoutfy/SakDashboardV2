{
  "name": "sak-platform",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@sak/dashboard",
    "dev:sales": "npm run dev --workspace=@sak/sales",
    "dev:all": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:dashboard": "npm run build --workspace=@sak/dashboard",
    "build:sales": "npm run build --workspace=@sak/sales",
    "lint": "npm run lint --workspaces --if-present",
    "preview": "npm run preview --workspace=@sak/dashboard",
    "predeploy": "npm run build:dashboard",
    "deploy": "gh-pages -d apps/dashboard/dist"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
