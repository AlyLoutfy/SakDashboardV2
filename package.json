{
  "name": "sak-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@sak/dashboard",
    "build": "npm run build --workspace=@sak/dashboard",
    "lint": "npm run lint --workspace=@sak/dashboard",
    "preview": "npm run preview --workspace=@sak/dashboard",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d apps/dashboard/dist"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "shadcn": "^3.8.4"
  }
}
